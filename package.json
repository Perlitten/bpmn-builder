{
  "name": "bpmn-builder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @bpmn/web --filter @bpmn/api-server dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "db:migrate": "pnpm --filter @bpmn/db migrate",
    "db:generate": "pnpm --filter @bpmn/db generate"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@bpmn/db": "workspace:*",
    "@vercel/functions": "^3.9.3",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "typescript": "~5.8.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "better-sqlite3"
    ]
  }
}
