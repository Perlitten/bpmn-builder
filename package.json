{
  "name": "bpmn-builder",
  "private": true,
  "version": "0.6.1",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @bpmn/web --filter @bpmn/api-server dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r --parallel exec tsc --noEmit",
    "audit:deps": "pnpm audit --prod --audit-level high",
    "audit:all": "corepack pnpm audit --audit-level low --ignore CVE-2026-56876",
    "check": "pnpm tokens:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build",
    "db:migrate": "pnpm --filter @bpmn/db migrate",
    "db:generate": "pnpm --filter @bpmn/db generate",
    "quality:performance": "lhci autorun --config=lighthouserc.cjs && node scripts/check-bundle-size.mjs",
    "tokens:generate": "node scripts/generate-tokens.mjs",
    "tokens:check": "node scripts/generate-tokens.mjs --check"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@bpmn/db": "workspace:*",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.5",
    "fast-check": "^4.9.0",
    "globals": "^15.15.0",
    "jsdom": "26.1.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "esbuild@<=0.24.2": "0.25.12",
      "jsdom": "26.1.0",
      "@lhci/cli>tmp": "0.2.7",
      "external-editor>tmp": "0.2.7",
      "@lhci/cli>uuid": "11.1.1"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "better-sqlite3"
    ],
    "auditConfig": {
      "ignoreCves": [
        "CVE-2026-56876"
      ]
    }
  }
}
