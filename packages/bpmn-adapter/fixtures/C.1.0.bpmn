<?xml version="1.0" encoding="UTF-8"?>
<!-- OMG MIWG-inspired C.1.0: collaboration + message flow. Local fixture; not the official suite. DI coordinates are junk on purpose. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_C10" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Pool 1" processRef="Process_1" />
    <bpmn:participant id="Participant_2" name="Pool 2" processRef="Process_2" />
    <bpmn:messageFlow id="MessageFlow_1" name="Request" sourceRef="Task_1" targetRef="Task_2" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" name="C.1.0 Host" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Start Event" />
    <bpmn:task id="Task_1" name="Send request" />
    <bpmn:endEvent id="EndEvent_1" name="End Event" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_1" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmn:process id="Process_2" name="C.1.0 Partner" isExecutable="false">
    <bpmn:startEvent id="StartEvent_2" name="Start Event" />
    <bpmn:task id="Task_2" name="Handle request" />
    <bpmn:endEvent id="EndEvent_2" name="End Event" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="StartEvent_2" targetRef="Task_2" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_2" targetRef="EndEvent_2" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_1_di" bpmnElement="Participant_1" isHorizontal="true">
        <dc:Bounds x="9999" y="1" width="600" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_1_di" bpmnElement="Task_1">
        <dc:Bounds x="9999" y="1" width="100" height="80" />
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
