# Database Connection Configuration
# Local SQLite default:
DATABASE_URL=file:./data/bpmn.db
DB_PROVIDER=sqlite

# Production / Staging Neon Postgres:
# DB_PROVIDER=postgres
# DATABASE_URL=postgresql://user:password@ep-pooler.fra1.postgres.neon.tech/neondb?sslmode=require (Pooled connection for app)
# DATABASE_URL_UNPOOLED=postgresql://user:password@ep-direct.fra1.postgres.neon.tech/neondb?sslmode=require (Direct connection for Drizzle Kit & migrations)

PORT=5173

# Google OAuth (server-only; NEVER expose with a VITE_ prefix to avoid client bundle leakage)
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID
#   Application type: Web application
#   Authorized JavaScript origins: http://localhost:5173
#   Authorized redirect URIs:     http://localhost:5173/api/auth/google/callback
# Production: same paths on your public origin, e.g. https://example.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=

# Optional override if the request Host is wrong behind a reverse proxy or for dynamic preview staging forwarding:
# AUTH_BASE_URL=http://localhost:5173

# Test-only Auth Flag (Strictly disabled and ignored in NODE_ENV=production):
# ENABLE_TEST_AUTH=false

# AI Configuration (server-only; fill locally, do not commit real secrets)
AI_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
LLM_MODEL=meta/llama-3.3-70b-instruct
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview
